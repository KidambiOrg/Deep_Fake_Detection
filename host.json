{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "functionTimeout": "00:30:00",
  "extensions": {
    "http": {
      "routePrefix": "v1.0",
      "maxOutstandingRequests": 200,
      "maxConcurrentRequests": 100,
      "dynamicThrottlesEnabled": true
    },
    "mcp": {
      "instructions": "Deepfake Detection MCP Server - Provides tools for detecting deepfakes in images and text, including model listing and analysis capabilities.",
      "serverName": "DeepfakeDetectionServer",
      "serverVersion": "1.0.0",
      "encryptClientState": true,
      "messageOptions": {
        "useAbsoluteUriForEndpoint": false
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle.Experimental",
    "version": "[4.0.0, 5.0.0)"    
  }
}