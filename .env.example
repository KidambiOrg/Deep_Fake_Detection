# Azure AI Foundry Configuration for Agent Framework
AZURE_AI_PROJECT_ENDPOINT=https://your-project-name.services.ai.azure.com/api/projects/your-project-id
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4

# Azure Storage Configuration
STORAGE_ACCOUNT_NAME=your_storage_account_name
MODEL_BLOB_STORAGE=your-connection-string-here

# Azure Functions Configuration
AzureWebJobsStorage=UseDevelopmentStorage=true
FUNCTIONS_WORKER_RUNTIME=python
PYTHON_ISOLATE_WORKER_DEPENDENCIES=1
FUNCTIONS_WORKER_PROCESS_COUNT=1
languageWorkers:python:arguments=-W ignore
AzureWebJobsFeatureFlags=EnableWorkerIndexing
PYTHON_ENABLE_WORKER_EXTENSIONS=1